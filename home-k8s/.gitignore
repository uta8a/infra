# Credentials and local environment files must never enter this repository.
.env
.env.*
!.env.example
secrets.yaml
talosconfig
kubeconfig
*.key
*.pem
*.crt
.artifacts/
*.snapshot
*.qcow2

# Generated Talos credentials and machine configurations are secret material.
talos/generated/
talos/secrets/

# Private hardware inventory.  Keep the examples below source-controlled.
talos/private/*-private.yaml
!talos/private/*-private.example.yaml

# Recovery output is intentionally local and owner-readable only.
.recovery/
